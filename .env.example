# Shared
NODE_ENV=development

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Public URL of the API (e.g. your ngrok tunnel). Used to build webhook URLs shown to users.
PUBLIC_API_ORIGIN=https://your-tunnel.ngrok-free.dev
# Used to encrypt saved Razorpay key secrets at rest (recommended: 64 hex chars).
ENCRYPTION_KEY=replace_with_a_long_random_string_at_least_32_chars
MONGODB_URI=mongodb+srv://your_user:your_password@your-cluster.mongodb.net/
SESSION_SECRET=replace_with_a_long_random_secret_at_least_16_chars
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
# Local testing: route all emails to the email catcher instead of the internet
EMAIL_INTERCEPT_URL=http://127.0.0.1:8098

# Operations
# true keeps plan switches sandbox-style (no real charge); false requires a real billing gateway.
SUBSCRIPTION_SANDBOX=true
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=you@example.com

# Web
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_APP_NAME=PayFlow

# Payments (Razorpay test mode; replace with your own test/live keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_at_least_16_chars
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# Later (do not fill until those slices)
# SUBSCRIPTION_PROVIDER_KEY_ID=
# SUBSCRIPTION_PROVIDER_KEY_SECRET=
# SENTRY_DSN=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=