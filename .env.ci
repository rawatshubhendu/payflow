# Committed CI/test environment. Values are non-secret, disposable test values
# that let the API unit/security/integration tests and the Playwright E2E suite
# boot a local stack. Production secrets live in the Render dashboard / GitHub
# secrets and are never committed.

NODE_ENV=test

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
PUBLIC_API_ORIGIN=http://localhost:4000
ENCRYPTION_KEY=ci_encryption_key_at_least_32_chars_0123456789
MONGODB_URI=mongodb://127.0.0.1:27017/payflow_ci
SESSION_SECRET=ci_session_secret_at_least_16_chars
EMAIL_PROVIDER_API_KEY=re_ci_test_key
EMAIL_FROM=onboarding@payflow.test
EMAIL_INTERCEPT_URL=http://127.0.0.1:8098

# Operations
SUBSCRIPTION_SANDBOX=true
ADMIN_EMAILS=admin@payflow.test

# Web
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_APP_NAME=PayFlow

# Payments (Razorpay sandbox keys; fake for CI)
RAZORPAY_KEY_ID=rzp_test_ci_key_id
RAZORPAY_KEY_SECRET=rzp_test_ci_key_secret
RAZORPAY_WEBHOOK_SECRET=ci_webhook_secret_at_least_16_chars